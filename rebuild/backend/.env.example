# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，禁止提交。
# 唯一数据源：全项目只认这一个 DATABASE_URL（坑 2 / 坑 6）
DATABASE_URL=sqlite:///./app.db

# 智谱 AI Key —— 只从环境变量读取，绝不硬编码进代码或提交仓库（坑 1）
ZHIPU_API_KEY=

# ── AI 运行参数（Phase 2，全部可选，留空即用代码默认值）─────────────────
# 默认供应商：zhipu（真实调用）| mock（固定假文本，仅离线联调；产物不可发布）
# AI_PROVIDER=zhipu
# ZHIPU_MODEL=glm-4-flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# AI_TIMEOUT_SECONDS=120
# AI_MAX_ATTEMPTS=3          # 含首次，共尝试 3 次
# AI_BASE_DELAY_SECONDS=1    # 指数退避基数：1s → 2s → 4s（上限 30s）
# AI_MAX_TOKENS=16000
# AI_TEMPERATURE=0.9

# 可选：素材根目录（用于 scripts 扫盘入库）
# MATERIALS_ROOT=/absolute/path/to/materials

# 可选：图片 URL 前缀，默认 /images
# IMG_BASE_URL=/images

# 可选：运行环境标识，默认 dev
# APP_ENV=dev
